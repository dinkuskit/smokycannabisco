---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/source-sans-3/wght.css';
import '../styles/site.css';
import { safeHref } from '../content/blocks';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  brandName: string;
  navLabel: string;
  navHref: string;
  footerText: string;
  ogImageAlt: string;
  contentSource?: 'cms' | 'seed' | 'none';
  page?: string;
  faqItems?: FaqItem[];
}
const {
  title,
  description,
  brandName,
  navLabel,
  navHref,
  footerText,
  ogImageAlt,
  contentSource = 'none',
  page,
  faqItems = [],
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(pathname, Astro.site ?? 'https://www.smokycannabisco.com');
const ogImage = new URL('/og-image.jpg', canonical);
const storeHref = safeHref(navHref);
const ga4MeasurementId = import.meta.env.PUBLIC_GA4_MEASUREMENT_ID;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical.toString(),
  isPartOf: {
    '@type': 'WebSite',
    name: brandName,
    url: 'https://www.smokycannabisco.com/',
  },
  publisher: {
    '@type': 'Organization',
    name: brandName,
    url: 'https://www.smokycannabisco.com/',
    description: 'A separate informational site for Smoky Cannabis Company; not Great Smoky Cannabis Company or the Cherokee dispensary.',
  },
};
const faqJsonLd = faqItems.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;
---
<!doctype html>
<html lang="en" data-page={page}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt || brandName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
    {ga4MeasurementId && /^G-[A-Z0-9]+$/i.test(ga4MeasurementId) && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${ga4MeasurementId}`}></script>
        <script define:vars={{ ga4MeasurementId }}>
          {`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', ga4MeasurementId, { anonymize_ip: true });`}
        </script>
      </>
    )}
  </head>
  <body data-content-source={contentSource}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">{brandName}</span>
      </a>
      <nav aria-label="Main">
        {storeHref && navLabel && (
          <a href={storeHref} target="_blank" rel="noopener noreferrer">{navLabel}</a>
        )}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <p>{footerText}</p>
    </footer>
  </body>
</html>
